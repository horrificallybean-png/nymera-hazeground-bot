{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm ci --include=dev && npm run build"
  },
  "deploy": {
    "startCommand": "npm run prisma:setup && npm start",
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10
  }
}
