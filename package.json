{
  "name": "nymera-hazeground-auto-games-sqlite",
  "version": "14.8.0",
  "private": true,
  "description": "Complete SQLite Nymera bot with rotating automatic Discord games",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings=0",
    "check": "tsc --noEmit",
    "register": "tsx src/register-commands.ts",
    "register:built": "node dist/register-commands.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/ensure-sqlite.mjs && prisma db push",
    "prisma:setup": "node scripts/ensure-sqlite.mjs && prisma db push",
    "prisma:dev": "prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "discord.js": "^14.19.3",
    "dotenv": "^16.5.0",
    "node-cron": "^4.2.1",
    "openai": "^5.10.1",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.7.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^22.15.32",
    "eslint": "^9.29.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1"
  }
}

